# ─── Supabase Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xwkkwmplohwsnwxjxusx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ─── Google Gemini AI (get your own free key from https://aistudio.google.com/) ────
# Replace with your own key — each developer needs their own Gemini key
GEMINI_API_KEY=your-own-gemini-key-from-aistudio.google.com

# ─── OAuth Providers (configured inside Supabase Dashboard — no extra setup needed) ─
# Google & LinkedIn OAuth is already configured in the shared Supabase project above.
# No additional environment variables needed for OAuth.
